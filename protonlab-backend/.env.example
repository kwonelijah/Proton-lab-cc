# ─── Stripe ───────────────────────────────────────────────────────────────────
# Found in Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...

# Found in Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=your_sheet_id_here

# Paste the entire contents of your Google Service Account JSON key file here (as a single line)
# Generated in Google Cloud Console → IAM → Service Accounts → Keys → Add Key → JSON
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ─── Anthropic (Claude agent) ─────────────────────────────────────────────────
# Found at console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── Resend (order confirmation emails) ───────────────────────────────────────
# Found at resend.com → API Keys
proton_resend_key=re_...

# ─── Site URL ─────────────────────────────────────────────────────────────────
# Used for Stripe success/cancel redirect URLs
SITE_URL=https://protonlab.cc

# ─── Meta Conversions API ─────────────────────────────────────────────────────
# Pixel/dataset ID from Meta Events Manager → Data Sources → your pixel
META_PIXEL_ID=1234567890
# Generate in Events Manager → your pixel → Settings → Conversions API → Generate access token
META_CAPI_ACCESS_TOKEN=EAA...
# Optional — while set, events go to Events Manager → Test Events instead of live.
# Remove (or leave empty) in production.
META_TEST_EVENT_CODE=

# ─── Ops alerts ───────────────────────────────────────────────────────────────
# Optional — where checkout-failure alerts and daily health-check alarms go.
# Defaults to info@protonlab.cc when unset.
ALERT_EMAIL=

# ─── GA4 Measurement Protocol (server-side purchase events) ───────────────────
# Web data stream Measurement ID — GA4 Admin → Data streams → your web stream.
# Same G-… id the frontend loads gtag.js with.
GA4_MEASUREMENT_ID=G-N5CHBCPQPF
# GA4 Admin → Data streams → your web stream → Measurement Protocol API secrets
# → Create. Keep secret — anyone holding it can inject events into the property.
GA4_API_SECRET=your_mp_api_secret_here

# ─── Evri export ──────────────────────────────────────────────────────────────
# Any long random string. Required to access /api/export-evri (returns customer
# addresses, so keep it secret). Pass it as ?key=... when downloading the CSV.
proton_export_key=change_me_to_a_long_random_string

# ─── GA4 Data API (analytics funnel) ──────────────────────────────────────────
# NUMERIC property id — GA4 Admin → Property settings → Property details →
# "Property ID" (NOT the G-… measurement id). The dashboard's checkout-funnel
# card reads page_view / view_item / add_to_cart / begin_checkout / purchase
# through the Google service account above, so once:
#   1. enable "Google Analytics Data API" in that service account's GCP project
#   2. GA4 Admin → Property access management → add the service account's
#      client_email as Viewer
GA4_PROPERTY_ID=…

# ─── Bank-transfer club shops (api/bank-transfer-order.js) ────────────────────
# Orders paid by bank transfer are stored in the project's PRIVATE Vercel Blob
# store (Vercel → Storage → Create → Blob → connect to this project; the token
# below is injected automatically — redeploy after connecting). The account
# customers pay INTO lives in config/bank.js; the BANK_* variables are
# optional overrides (e.g. a preview deploy) and are normally left unset.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_…
# BANK_ACCOUNT_NAME=
# BANK_SORT_CODE=
# BANK_ACCOUNT_NUMBER=
# BANK_IBAN=
# BANK_BIC=
