{
  "version": 2,
  "functions": {
    "api/webhook.js": {
      "maxDuration": 30
    },
    "api/admin.js": {
      "maxDuration": 60,
      "includeFiles": "{dashboard/**,lib/today.cjs}"
    },
    "api/stock-sync.js": {
      "maxDuration": 60
    },
    "api/health-checkout.js": {
      "maxDuration": 30
    },
    "api/analytics.js": {
      "maxDuration": 60
    },
    "api/bank-transfer-order.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/stock-sync",
      "schedule": "0 20 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/api/admin?view=app"
    },
    {
      "source": "/login",
      "destination": "/api/admin?view=login"
    },
    {
      "source": "/sw.js",
      "destination": "/api/admin?view=sw"
    },
    {
      "source": "/sync-layer.js",
      "destination": "/api/admin?view=sync"
    },
    {
      "source": "/today.js",
      "destination": "/api/admin?view=today"
    },
    {
      "source": "/manifest.json",
      "destination": "/api/admin?view=manifest"
    },
    {
      "source": "/icon.png",
      "destination": "/api/admin?view=icon"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/dashboard",
      "permanent": false
    }
  ]
}
